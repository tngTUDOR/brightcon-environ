[Unit]
Description=Rebuild JupyterHub environments from GitHub webhooks
After=network.target
Wants=network-online.target

[Service]
# Creating environments under /opt/tljh/user and writing kernelspecs into the
# shared prefix are root operations, the same ones a TLJH admin performs with
# sudo from a terminal.
User=root
UMask=0022
Environment="ENVIRON_CONFIG=/opt/tljh/config/environ.toml"
# Redirect tool caches and uv-managed CPython installs under /opt/tljh so
# ProtectHome=read-only does not block them. UV_CACHE_DIR covers wheels;
# UV_PYTHON_INSTALL_DIR / XDG_DATA_HOME cover `uv venv --python …`.
Environment="UV_CACHE_DIR=/opt/tljh/environ/cache/uv"
Environment="UV_PYTHON_INSTALL_DIR=/opt/tljh/environ/cache/uv-python"
Environment="CONDA_PKGS_DIRS=/opt/tljh/environ/cache/conda/pkgs"
Environment="XDG_CACHE_HOME=/opt/tljh/environ/cache"
Environment="XDG_DATA_HOME=/opt/tljh/environ/cache/share"
EnvironmentFile=/etc/brightcon-environ.env
ExecStart=/opt/tljh/environ/venv/bin/environ serve
Restart=always
RestartSec=5

# The service only ever writes under these trees.
ProtectHome=read-only
ReadWritePaths=/opt/tljh
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
