# Install as /etc/brightcon-environ.env with mode 0600.
#
#   GITHUB_WEBHOOK_SECRET  the secret configured on the GitHub webhook;
#                          without it /hooks/github rejects every delivery
#   ENVIRON_ADMIN_TOKEN    bearer token for the manual POST /rebuild endpoint
#   GITHUB_CHECKS_TOKEN    optional fine-grained PAT (Checks: Read and write
#                          on the definitions repo) to post Check Runs
#
# Generate the first two with: openssl rand -hex 32

GITHUB_WEBHOOK_SECRET=change-me
ENVIRON_ADMIN_TOKEN=change-me-too
# GITHUB_CHECKS_TOKEN=github_pat_...
