# Install as /etc/brightcon-environ.env with mode 0600.
#
#   GITHUB_WEBHOOK_SECRET           secret configured on the GitHub webhook;
#                                   without it /hooks/github rejects every delivery
#   ENVIRON_ADMIN_TOKEN             bearer token for the manual POST /rebuild endpoint
#   GITHUB_APP_ID                   GitHub App ID (integer) for Check Runs
#   GITHUB_APP_INSTALLATION_ID      installation ID on the definitions repo
#   GITHUB_APP_PRIVATE_KEY_FILE     path to the App private key PEM (mode 0600)
#
# Generate the first two with: openssl rand -hex 32
# Store the PEM under /etc/brightcon-environ/, not under /opt/tljh.

GITHUB_WEBHOOK_SECRET=change-me
ENVIRON_ADMIN_TOKEN=change-me-too
# GITHUB_APP_ID=123456
# GITHUB_APP_INSTALLATION_ID=12345678
# GITHUB_APP_PRIVATE_KEY_FILE=/etc/brightcon-environ/github-app.pem
